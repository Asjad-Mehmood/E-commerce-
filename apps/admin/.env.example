# ── Local development ───────────────────────────────
# Backend API URL used by the browser. On Vercel leave it unset: it defaults to
# "/api/v1" (proxied by middleware.ts).
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# The API's own address (used by the /api/v1 proxy on Vercel).
API_URL=http://localhost:4000/api/v1
# The storefront's address (links to products and orders).
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000

# ── Vercel ──────────────────────────────────────────
# Same value as PROXY_SECRET on the API project.
# PROXY_SECRET=
