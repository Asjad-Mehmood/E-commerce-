# Public URL of the backend API, used by the browser (baked in at build time).
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# API URL used by the Next.js server (can be an internal address in production).
API_URL=http://localhost:4000/api/v1
# Public URL of this site (used for canonical URLs, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_STORE_NAME=Hoodie Store
