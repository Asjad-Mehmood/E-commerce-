# The shop, the admin panel (/admin) and the API (/api/v1) are one site.
# The API's settings (database, secrets…) are read from apps/api/.env.

# Public URL of this site (canonical URLs, sitemap, Open Graph). On Vercel it
# defaults to the production domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_STORE_NAME="Urban Store"
