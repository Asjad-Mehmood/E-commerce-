# ── Local development ───────────────────────────────
# Public URL of the backend API, used by the browser (baked in at build time).
# On Vercel leave it unset: it defaults to "/api/v1" (proxied by middleware.ts).
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# The API's own address, used by the server (and by the /api/v1 proxy on Vercel).
API_URL=http://localhost:4000/api/v1
# Public URL of this site (canonical URLs, sitemap, Open Graph). On Vercel it
# defaults to the production domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_STORE_NAME="Urban Store"

# ── Vercel ──────────────────────────────────────────
# Same value as PROXY_SECRET on the API project.
# PROXY_SECRET=
