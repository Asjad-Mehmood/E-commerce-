# ── Server ───────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# ── Database (matches docker-compose.yml) ────────────
DATABASE_URL=postgresql://hoodie:hoodie@localhost:5432/hoodie_store?schema=public
# Tests use DATABASE_URL with a "_test" suffix (hoodie_store_test) unless this is set.
# TEST_DATABASE_URL=

# ── Redis: shared rate limits (in-memory when unset) ─
REDIS_URL=redis://localhost:6379

# ── CORS / CSRF: comma-separated allowed browser origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Auth ────────────────────────────────────────────
# Generate a real one for production: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-insecure-secret-change-me-0123456789
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# Share cookies across subdomains in production, e.g. .example.com
# COOKIE_DOMAIN=
# Secure cookies are forced on in production.
COOKIE_SECURE=false
RATE_LIMIT_ENABLED=true

# ── Links in emails ─────────────────────────────────
STOREFRONT_URL=http://localhost:3000

# ── Email: printed to the API log when RESEND_API_KEY is empty
# RESEND_API_KEY=
EMAIL_FROM=Hoodie Store <no-reply@hoodie.local>

# ── Image uploads (Cloudinary). Upload signing returns 503 until set.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ── API docs at /api/docs (on by default outside production)
# API_DOCS_ENABLED=true

# ── Seed: first Super Admin account ─────────────────
SEED_ADMIN_EMAIL=admin@hoodie.local
SEED_ADMIN_PASSWORD=ChangeMe123

# ── Added in later phases ───────────────────────────
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# SENTRY_DSN=
