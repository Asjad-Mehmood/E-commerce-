# ── Server ───────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# ── Database (matches docker-compose.yml) ────────────
DATABASE_URL=postgresql://hoodie:hoodie@localhost:5432/hoodie_store?schema=public

# ── Redis (used from Phase 1: rate limiting, queues) ─
REDIS_URL=redis://localhost:6379

# ── CORS: comma-separated allowed browser origins ────
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Seed: first Super Admin account ─────────────────
SEED_ADMIN_EMAIL=admin@hoodie.local
SEED_ADMIN_PASSWORD=ChangeMe123

