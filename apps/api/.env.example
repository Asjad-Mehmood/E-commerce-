# ── Server ───────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# ── Database (matches docker-compose.yml) ────────────
DATABASE_URL=postgresql://hoodie:hoodie@localhost:5432/hoodie_store?schema=public
# Tests use DATABASE_URL with a "_test" suffix (hoodie_store_test) unless this is set.
# TEST_DATABASE_URL=

# ── Redis: shared rate limits (in-memory when unset) ─
REDIS_URL=redis://localhost:6379

# ── CORS / CSRF: browser origins allowed to call the API (default: the site itself)
# CORS_ORIGINS=http://localhost:3000

# ── Auth ────────────────────────────────────────────
# Generate a real one for production: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-insecure-secret-change-me-0123456789
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# Share cookies across subdomains in production, e.g. .example.com
# COOKIE_DOMAIN=
# Secure cookies are forced on in production.
COOKIE_SECURE=false
RATE_LIMIT_ENABLED=true

# ── The site ────────────────────────────────────────
# One site serves the shop, the admin panel (/admin) and this API (/api/v1).
# Used for links in emails. On Vercel it defaults to the production domain.
STOREFRONT_URL=http://localhost:3000

# ── Email: off until set up in the admin (Store settings → Email). Nothing is sent before that.
# RESEND_API_KEY=
# Default "from" address; the address set in Store settings → Email takes precedence.
EMAIL_FROM="Urban Store <orders@urbanstore.pk>"

# ── Image uploads: optional Cloudinary. Without it, images go in the database.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# Without Cloudinary, uploaded images are stored in the database and served by
# the API at /api/v1/media/... (no account needed).
# ── API docs at /api/docs (on by default outside production)
# API_DOCS_ENABLED=true

# ── Seed: first Super Admin account ─────────────────
SEED_ADMIN_EMAIL=admin@hoodie.local
SEED_ADMIN_PASSWORD=ChangeMe123

# ── Payments ────────────────────────────────────────
# Without Stripe keys, card payments run in DEMO MODE: Stripe test cards only,
# no real money. Demo mode is off in production unless ALLOW_DEMO_PAYMENTS=true.
# To use real Stripe (test or live), set all three:
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# ALLOW_DEMO_PAYMENTS=true
# Minutes an unpaid card order holds its stock
PAYMENT_RESERVATION_MINUTES=15

# ── Background jobs ─────────────────────────────────
# With REDIS_URL set, emails and scheduled jobs (expired holds, cart reminders,
# daily summary) run on a BullMQ queue with retries. The worker runs inside the
# API unless RUN_WORKER=false (then run `node dist/worker.js` separately).
# Without Redis, jobs run in-process and the daily summary email is skipped.
# RUN_WORKER=true

# ── Hosting on Vercel (see DEPLOYMENT.md) ───────────
# Vercel Cron calls GET /api/v1/cron/daily with this secret (expired holds,
# cart reminders, review requests, daily summary). openssl rand -hex 32
# CRON_SECRET=
# Migrations use the direct (unpooled) connection when set (the Neon
# integration sets DATABASE_URL_UNPOOLED automatically).
# DATABASE_URL_UNPOOLED=

# ── Google sign-in (optional) ───────────────────────
# Create an OAuth client (Web application) in Google Cloud Console and add the
# redirect URI  <your site>/api/v1/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
