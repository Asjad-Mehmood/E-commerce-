# ── Server ───────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# ── Database (matches docker-compose.yml) ────────────
DATABASE_URL=postgresql://hoodie:hoodie@localhost:5432/hoodie_store?schema=public
# Tests use DATABASE_URL with a "_test" suffix (hoodie_store_test) unless this is set.
# TEST_DATABASE_URL=

# ── Redis: shared rate limits (in-memory when unset) ─
REDIS_URL=redis://localhost:6379

# ── CORS / CSRF: comma-separated allowed browser origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Auth ────────────────────────────────────────────
# Generate a real one for production: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-insecure-secret-change-me-0123456789
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# Share cookies across subdomains in production, e.g. .example.com
# COOKIE_DOMAIN=
# Secure cookies are forced on in production.
COOKIE_SECURE=false
RATE_LIMIT_ENABLED=true

# ── Links in emails ─────────────────────────────────
STOREFRONT_URL=http://localhost:3000

# ── Email: printed to the API log when RESEND_API_KEY is empty
# RESEND_API_KEY=
EMAIL_FROM=Hoodie Store <no-reply@hoodie.local>

# ── Image uploads (Cloudinary). Upload signing returns 503 until set.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# Without Cloudinary, uploads are saved to UPLOADS_DIR and served by the API
# (on by default outside production).
# LOCAL_UPLOADS=true
# UPLOADS_DIR=uploads
# Public origin of the API, used to build URLs of locally stored images
API_PUBLIC_URL=http://localhost:4000
# Admin panel URL, used in staff invitation emails
ADMIN_URL=http://localhost:3001

# ── API docs at /api/docs (on by default outside production)
# API_DOCS_ENABLED=true

# ── Seed: first Super Admin account ─────────────────
SEED_ADMIN_EMAIL=admin@hoodie.local
SEED_ADMIN_PASSWORD=ChangeMe123

# ── Payments ────────────────────────────────────────
# Without Stripe keys, card payments run in DEMO MODE: Stripe test cards only,
# no real money. Demo mode is off in production unless ALLOW_DEMO_PAYMENTS=true.
# To use real Stripe (test or live), set all three:
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# ALLOW_DEMO_PAYMENTS=true
# Minutes an unpaid card order holds its stock
PAYMENT_RESERVATION_MINUTES=15

# ── Background jobs ─────────────────────────────────
# With REDIS_URL set, emails and scheduled jobs (expired holds, cart reminders,
# daily summary) run on a BullMQ queue with retries. The worker runs inside the
# API unless RUN_WORKER=false (then run `node dist/worker.js` separately).
# Without Redis, jobs run in-process and the daily summary and review-request
# emails are skipped.
# RUN_WORKER=true

# ── Google sign-in (optional) ───────────────────────
# Create an OAuth client (Web application) in Google Cloud Console and add the
# redirect URI  <API_PUBLIC_URL>/api/v1/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ── Added in later phases ───────────────────────────
# SENTRY_DSN=
